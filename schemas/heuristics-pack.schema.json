{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interessence.dev/schemas/heuristics-pack.schema.json",
  "title": "Heuristics Pack",
  "$comment": "Adaptive heuristic knobs that shape predictable emergence before heavier training.",
  "type": "object",
  "required": ["schemaVersion", "metadata", "parameters"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$comment": "Core agent/world behavior knobs; signal engine settings live in signal-pack.",
        "startEnergy": { "type": "number" },
        "energyMax": { "type": "number" },
        "energyLeakPerSec": { "type": "number" },
        "energyGainPerFood": { "type": "number" },
        "sleepEnergyCost": { "type": "number" },
        "startChi": { "type": "number" },
        "chiMax": { "type": "number" },
        "chiLeakPerSec": { "type": "number" },
        "chiMoveCostPerSec": { "type": "number" },
        "chiActionCost": { "type": "number" },
        "chiRegenRateFromEnergy": { "type": "number" },
        "chiRegenThresholdEnergy": { "type": "number" },
        "maxSpeed": { "type": "number" },
        "turnRate": { "type": "number" },
        "sensingRadius": { "type": "number" },
        "sensingFalloff": { "type": "number" },
        "aiSensoryRangeBase": { "type": "number" },
        "aiSensoryRangeMax": { "type": "number" },
        "aiSenseRangePerChi": { "type": "number" },
        "aiSenseSlewPerSec": { "type": "number" },
        "aiSenseBiasFromStress": { "type": "number" },
        "trailDiffusion": { "type": "number" },
        "trailDecay": { "type": "number" },
        "trailDepositPerSec": { "type": "number" },
        "trailEvapPerSec": { "type": "number" },
        "trailDiffusePerSec": { "type": "number" },
        "enableDiffusion": { "type": "boolean" },
        "residualGainPerSec": { "type": "number" },
        "residualCapPerTick": { "type": "number" },
        "ownTrailPenalty": { "type": "number" },
        "ownTrailGraceAge": { "type": "number" },
        "mitosisThreshold": { "type": "number" },
        "mitosisCost": { "type": "number" },
        "childStartChi": { "type": "number" },
        "mitosisCooldown": { "type": "number" },
        "spawnOffset": { "type": "number" },
        "inheritHeading": { "type": "boolean" },
        "headingNoise": { "type": "number" },
        "buddingThreshold": { "type": "number" },
        "buddingShare": { "type": "number" },
        "buddingOffset": { "type": "number" },
        "buddingRespectCooldown": { "type": "boolean" },
        "carryingCapacityMultiplier": { "type": "number" },
        "baselineThreshold": { "type": "number" },
        "baselineWeightCapacity": { "type": "number" },
        "baselineWeightStrain": { "type": "number" },
        "baselineWeightPressure": { "type": "number" },
        "baselineWeightOpportunity": { "type": "number" },
        "baselineWeightHarmony": { "type": "number" },
        "baselinePressureRadius": { "type": "number" },
        "baselinePressureMaxNeighbors": { "type": "number" },
        "baselineOpportunityRadius": { "type": "number" },
        "baselineOpportunityMaxResources": { "type": "number" },
        "hungerThresholdLow": { "type": "number" },
        "hungerThresholdHigh": { "type": "number" },
        "hungerBuildRate": { "type": "number" },
        "hungerDecayOnCollect": { "type": "number" },
        "hungerExplorationAmp": { "type": "number" },
        "hungerStressAmp": { "type": "number" },
        "hungerSenseAmp": { "type": "number" },
        "hungerSurgeAmp": { "type": "number" },
        "rewardResource": { "type": "number" },
        "rewardSurvival": { "type": "number" },
        "punishCollision": { "type": "number" },
        "punishIdle": { "type": "number" },
        "mutationRate": { "type": "number" },
        "mutationScale": { "type": "number" },
        "populationSize": { "type": "integer" },
        "eliteFraction": { "type": "number" },
        "fearSensitivity": { "type": "number" },
        "cohesionWeight": { "type": "number" },
        "separationWeight": { "type": "number" },
        "alignmentWeight": { "type": "number" },
        "aiExploreNoiseBase": { "type": "number" },
        "aiExploreNoiseGain": { "type": "number" },
        "aiTrailFollowingNear": { "type": "number" },
        "aiTrailFollowingFar": { "type": "number" },
        "aiSampleDistance": { "type": "number" },
        "aiResourceAttractionStrength": { "type": "number" },
        "aiResourceAttractionScaleWithDistance": { "type": "boolean" },
        "stressBuildRate": { "type": "number" },
        "stressDecayRate": { "type": "number" },
        "stressSightGrace": { "type": "number" },
        "stressLowTrail": { "type": "number" },
        "stressSurgeMax": { "type": "number" },
        "stressTurnRateBase": { "type": "number" },
        "stressTurnRateGain": { "type": "number" },
        "scentRewardScale": { "type": "number" },
        "scentRewardUpdateInterval": { "type": "number" },
        "scentConsumePerSec": { "type": "number" },
        "scentRecoverPerSec": { "type": "number" },
        "scentMinStrength": { "type": "number" },
        "scentMinRange": { "type": "number" },
        "scentVitalityConsumePerSec": { "type": "number" },
        "scentVitalityRecoverPerSec": { "type": "number" },
        "scentDepletionThreshold": { "type": "number" },
        "scentVitalityToChiRate": { "type": "number" },
        "decayDuration": { "type": "number" },
        "decayFertilityBoost": { "type": "number" },
        "decayReleaseRadius": { "type": "number" },
        "removeAfterDecay": { "type": "boolean" },
        "linkFormCost": { "type": "number" },
        "linkMaintPerSec": { "type": "number" },
        "linkDecayPerSec": { "type": "number" },
        "linkStrengthenPerUse": { "type": "number" },
        "linkInitStrength": { "type": "number" },
        "linkMinStrength": { "type": "number" },
        "guidanceGain": { "type": "number" },
        "springK": { "type": "number" },
        "transferCapPerSec": { "type": "number" },
        "transferLoss": { "type": "number" },
        "linkTrailMin": { "type": "number" },
        "hungerEscape": { "type": "number" },
        "linkHungerDecayPerSec": { "type": "number" },
        "episodeLength": { "type": "integer" },
        "terminateOnDeath": { "type": "boolean" },
        "adaptiveRewardGainFactor": { "type": "number" },
        "adaptiveRewardAvgMoveFraction": { "type": "number" },
        "adaptiveRewardEmaAlpha": { "type": "number" }
      }
    },
    "extensions": {
      "$comment": "Optional escape hatch for prototype-only knobs without breaking the core schema.",
      "type": "object",
      "additionalProperties": { "type": ["number", "integer", "string", "boolean"] }
    }
  }
}
